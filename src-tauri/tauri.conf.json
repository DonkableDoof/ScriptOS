{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScriptOS",
  "version": "../package.json",
  "identifier": "com.scriptos.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1440",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScriptOS",
        "width": 1400,
        "height": 900,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.github.com ipc: http://ipc.localhost https://utrgvdnnnggcyhiqdncr.supabase.co wss://utrgvdnnnggcyhiqdncr.supabase.co; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src * 'unsafe-inline' 'unsafe-eval' data: blob: ws: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2NkExNDE0Q0QzOTQ4NDEKUldSQlNEbk5GQlJxUnJuMWQzZXdhZEJwQ3draXNZdXU0VHl2ZmNXeXA5Ty9iMnNxT3RpSWE4QkYK",
      "endpoints": [
        "https://github.com/DonkableDoof/ScriptOS/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
